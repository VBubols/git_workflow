{
  "uid": "api-carrinho",
  "title": "API do Carrinho",
  "description": "Sinais de ouro da API (tráfego, erros, latência e saturação) e métricas de negócio do carrinho.",
  "tags": ["api", "observabilidade"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  },
  "panels": [
