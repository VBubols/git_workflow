{
  "name": "git_workflow",
  "version": "1.0.0",
  "description": "API REST de carrinho de compras com Express, Sequelize e PostgreSQL, orquestrada com Docker Compose",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/app.js",
      "src/controllers/**/*.js",
      "src/middlewares/**/*.js",
      "src/routes/**/*.js",
      "src/services/**/*.js"
    ]
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^15.15.0",
    "jest": "^30.5.1",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  }
}
